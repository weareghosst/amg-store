# ============================================================
# AMG Store — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o arquivo .env (já está no .gitignore).
# ============================================================

# --- Banco de dados (Neon) ---
# Painel do Neon > Dashboard > Connection string (use a "pooled connection")
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# --- Asaas (pagamentos) ---
# Sandbox: https://sandbox.asaas.com  |  Produção: https://www.asaas.com
# Gere a chave em: Menu > Integrações > Chave de API
ASAAS_API_KEY=""
# Sandbox: https://api-sandbox.asaas.com/v3  |  Produção: https://api.asaas.com/v3
ASAAS_BASE_URL="https://api-sandbox.asaas.com/v3"
# Token secreto que VOCÊ define ao cadastrar o webhook no painel do Asaas.
# Use um valor longo e aleatório (ex: saída de `openssl rand -hex 32`).
ASAAS_WEBHOOK_TOKEN=""

# --- Melhor Envio (frete fora de SP) ---
# Sandbox: https://sandbox.melhorenvio.com.br  |  Produção: https://melhorenvio.com.br
# Gere o token em: Painel > Integrações > Tokens
MELHOR_ENVIO_TOKEN=""
MELHOR_ENVIO_BASE_URL="https://sandbox.melhorenvio.com.br"
# E-mail de contato exigido pela API do Melhor Envio no header User-Agent
MELHOR_ENVIO_CONTACT_EMAIL="contato@exemplo.com.br"

# --- Aplicação ---
# URL pública do site (em produção: https://seudominio.com.br)
APP_URL="http://localhost:3000"

# --- Resend (e-mails transacionais) ---
# Gere a chave em: https://resend.com/api-keys
# Sem esta env var, o fluxo continua funcionando — em desenvolvimento o link
# de reset é logado no console em vez de enviado por e-mail.
RESEND_API_KEY=""
# Endereço remetente verificado no painel da Resend.
# Se não definido, derivamos de APP_URL (no-reply@<seu-dominio>).
RESEND_FROM_EMAIL=""

# --- Cron de limpeza ---
# Secret compartilhado com o agendador (Vercel Cron, GitHub Actions, etc.)
# que chama GET /api/cron/cleanup. Gere com: `openssl rand -hex 32`.
# Sem esta env var, o endpoint retorna 401.
CRON_SECRET=""

# WhatsApp do botão flutuante (fallback enquanto o banco não está configurado;
# depois, o número definido em Admin > Configurações tem prioridade).
# Somente dígitos com DDD, ex: 11999998888
WHATSAPP_PHONE="11963634729"

# --- Seed (primeiro administrador) ---
# Usados apenas pelo comando `npm run db:seed`
SEED_ADMIN_EMAIL="admin@amg.com.br"
SEED_ADMIN_PASSWORD="troque-esta-senha-forte"
SEED_ADMIN_NAME="Administrador AMG"

# --- Admin temporário (SOMENTE DESENVOLVIMENTO) ---
# Estas variáveis criam um atalho de login que bypassa o banco de dados,
# permitindo pré-visualizar o /admin sem ter feito `npm run db:seed`.
# O atalho fica TOTALMENTE DESATIVADO em produção (NODE_ENV=production),
# mesmo que as variáveis estejam definidas — não há fallback hardcoded.
# Deixe em branco (ou remova) para desativar também em dev.
TEMP_ADMIN_EMAIL="demo.admin@amg.local"
TEMP_ADMIN_PASSWORD="AmgDemo2026!"
TEMP_ADMIN_NAME="Admin temporário"
# Token aleatório do cookie mágico. Gere com: `openssl rand -hex 32`
TEMP_ADMIN_SESSION_TOKEN=""
