{
  "name": "amg-store-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/prepare-public-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "assets": "node scripts/prepare-assets.mjs && capacitor-assets generate --android --iconBackgroundColor '#0a1f66' --iconBackgroundColorDark '#0a1f66' --splashBackgroundColor '#0a1f66' --splashBackgroundColorDark '#0a1f66' --logoSplashScale 0.44",
    "sync": "npm run build && cap sync android && npm run assets",
    "android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
